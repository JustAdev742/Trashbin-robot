OOL\\\">FALSE</field>\\n</block>\\n</value>\\n<next>\\n<block id=\\\"1QqC4)S2FENUmhxE-1oL\\\" type=\\\"function_call\\\">\\n<mutation name=\\\"showMessage\\\">\\n<arg name=\\\"text\\\" type=\\\"string\\\" id=\\\"ek4e31sdqgk0f8b00djd\\\" />\\n</mutation>\\n<value name=\\\"ek4e31sdqgk0f8b00djd\\\">\\n<block type=\\\"text_join\\\">\\n<mutation items=\\\"3\\\" />\\n<value name=\\\"ADD0\\\">\\n<shadow type=\\\"text\\\">\\n<field name=\\\"TEXT\\\">P1 </field>\\n</shadow>\\n</value>\\n<value name=\\\"ADD1\\\">\\n<shadow type=\\\"text\\\"><field name=\\\"TEXT\\\" /></shadow>\\n<block id=\\\"2YO!*605|cqG!MV1feYq\\\" type=\\\"function_call_output\\\">\\n<mutation name=\\\"formatNumber\\\">\\n<arg name=\\\"n\\\" type=\\\"number\\\" id=\\\"86lav4dljkleyhqffmamdn\\\" />\\n</mutation>\\n<value name=\\\"86lav4dljkleyhqffmamdn\\\">\\n<block type=\\\"variables_get\\\">\\n<field name=\\\"VAR\\\">sensorVolts</field>\\n</block>\\n</value>\\n</block>\\n</value>\\n<value name=\\\"ADD2\\\">\\n<shadow type=\\\"text\\\">\\n<field name=\\\"TEXT\\\">V</field>\\n</shadow>\\n</value>\\n</block>\\n</value>\\n</block>\\n</next>\\n</block>\\n</statement>\\n</block>\\n</next>\\n</block>\\n</next>\\n</block>\\n</next>\\n</block>\\n</next>\\n<comment pinned=\\\"false\\\">While waiting to retry: A shows the pin voltage on the LEDs, B retries straight away</comment>\\n</block>\\n</next>\\n</block>\\n</next>\\n</block>\\n</next>\\n</block>\\n</next>\\n</block>\\n</next>\\n</block>\\n</next>\\n</block>\\n</statement>\\n<comment pinned=\\\"false\\\">Box: Show CHECK SENSOR, beep, retry in 5 s. The first time: a cross, the message\\nacross the LEDs and two beeps. While the fault lasts: the cross only, with the\\nmessage and beeps again about once a minute, so a device on a bench does not\\nbeep all day. A bad sensor is never treated as \\\"safe\\\". The app gets one ev=error\\nper problem, not one per retry, and the status line carries the pin voltage.\\nWhile it waits, A shows the pin voltage on the LEDs a